-- RESPAWN SUPPORT
--====================================================

Player.CharacterAdded:Connect(function()
    table.clear(OriginalCollision)

    task.wait(0.5)

    ApplySpeed()

    if Noclip then
        SetNoclip(true)
    end

    if NoonersESP then
        RefreshESP()
    end
end)

